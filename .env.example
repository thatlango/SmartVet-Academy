# The browser build has no Supabase/Lovable credentials.
# Runtime secrets are stored only on the VPS at /opt/tuku/secrets/smartvet-academy.env.
DATABASE_URL=postgresql://smartvet_academy_app:CHANGE_ME@core-postgres:5432/smartvet_academy
TUKU_CORE_URL=http://tuku-core-api:3000/api/v1
ALLOWED_ORIGIN=https://academy.smartvet.africa
PORT=4500
NODE_ENV=production
